rule validate_main_delivery:
    input:
        validations=[
            rules.prepare_raw_view.output.validation,
            rules.inventory_framework.output.validation,
            rules.inventory_hardware.output.validation,
            rules.validate_trace_metadata.output.validation,
            rules.validate_rank_gpu_mapping.output.validation,
            rules.build_event_windows.output.validation,
            rules.build_collective_bandwidth.output.validation,
            rules.finalize_collective_views.output.validation,
            rules.build_rank_nic_mapping.output.validation,
            rules.build_ep_phase_constrained.output.validation,
            rules.build_edp_rank_nic.output.validation,
            rules.build_dp_active.output.validation,
            rules.build_cp_active.output.validation,
            rules.build_main_heatmap.output.validation,
        ],
        artifacts=[
            rules.build_main_heatmap.output.cells,
            rules.build_main_heatmap.output.html,
        ],
        checker="workflow/scripts/check_validation.py",
    output:
        MAIN_STAMP,
    params:
        python=PY,
    log:
        f"{LOGS}/validate_main_delivery.log",
    shell:
        """
        mkdir -p $(dirname {log})
        {params.python} {input.checker} \
          --output {output} \
          {input.validations} \
          > {log} 2>&1
        """


