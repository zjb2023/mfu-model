        events_pre_mtlink=f"{COLLECTIVE}/collective_events_no_pp_pre_mtlink.parquet",
        events=f"{COLLECTIVE}/collective_event_bandwidth_no_pp.parquet",
        cells=f"{COLLECTIVE}/collective_iter_rank_bandwidth_no_pp.csv",
        summary=f"{COLLECTIVE}/collective_type_bandwidth_summary_no_pp.csv",
        validation=f"{COLLECTIVE}/collective_bandwidth_validation_no_pp.json",
    params:
        python=PY,
        framework_root=RAW["framework_root"],
        raw_view=RAW_VIEW,
        output_dir=COLLECTIVE,
        long_gap_ms=CONTRACT["mtlink_long_gap_ms"],
        world_size=CONTRACT["world_size"],
        expected_events=CONTRACT["expected_deepep_events"],
    resources:
        io_heavy=1,
    log:
        f"{LOGS}/build_collective_bandwidth.log",
    shell:
        """
        mkdir -p $(dirname {log})
        {params.python} {input.code} \
          --framework-root {params.framework_root} \
          --hardware-root {params.raw_view} \
