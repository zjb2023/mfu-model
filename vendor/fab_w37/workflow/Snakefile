rule build_collective_bandwidth:
    input:
        code=f"{SCRIPTS}/build_collective_bandwidth_no_pp.py",
        raw_view=rules.prepare_raw_view.output.validation,
        manifest=rules.inventory_framework.output.manifest,
        trace_metadata=rules.validate_trace_metadata.output.metadata,
