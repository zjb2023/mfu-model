          --trace-metadata {input.trace_metadata} \
          --event-windows {input.event_windows} \
          --rank-topology {input.topology} \
          --mtlink-manifest {input.mtlink} \
          --output-dir {params.output_dir} \
          --mtlink-long-gap-ms {params.long_gap_ms} \
          --world-size {params.world_size} \
          --expected-deepep-events {params.expected_events} \
          > {log} 2>&1
