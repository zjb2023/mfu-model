configfile: "workflow/config/case256.yaml"


CASE = config["case_root"]
PY = config["analysis_python"]
RAW = config["raw"]
WORKERS = config["workers"]
CONTRACT = config["contract"]

SCRIPTS = f"{CASE}/scripts"
READINESS = f"{CASE}/results/readiness"
TOPOLOGY = f"{CASE}/results/topology"
COLLECTIVE = f"{CASE}/results/collective_bw_no_pp"
DASHBOARD = f"{CASE}/results/dashboard_reference"
EP_ACTIVE = f"{CASE}/results/ep_active_time_bw"
FIGURES = f"{CASE}/figures"
LOGS = f"{CASE}/logs/snakemake"
RAW_VIEW = f"{CASE}/.raw_view"
STAMPS = ".snakemake-stamps"

MAIN_HTML = f"{FIGURES}/communication_spatial_heatmaps_ep_phase_constrained.html"
EP_ACTIVE_HTML = f"{FIGURES}/communication_spatial_heatmaps_ep_active_time.html"
MAIN_STAMP = f"{STAMPS}/case256-main.pass.json"
EP_ACTIVE_STAMP = f"{STAMPS}/case256-ep-active.pass.json"


rule all:
    input:
        MAIN_HTML,
        EP_ACTIVE_HTML,
        MAIN_STAMP,
        EP_ACTIVE_STAMP,


