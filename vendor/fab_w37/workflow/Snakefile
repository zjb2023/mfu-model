            rules.build_ep_active_time.output.compounds,
            rules.build_ep_active_heatmap.output.html,
        ],
        checker="workflow/scripts/check_validation.py",
    output:
        EP_ACTIVE_STAMP,
    params:
        python=PY,
    log:
        f"{LOGS}/validate_ep_active_delivery.log",
    shell:
        """
        mkdir -p $(dirname {log})
        {params.python} {input.checker} \
          --output {output} \
          {input.validations} \
          > {log} 2>&1
        """


