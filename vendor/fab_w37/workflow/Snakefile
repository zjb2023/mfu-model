        cp_validation=rules.build_cp_active.output.validation,
    output:
        cells=f"{COLLECTIVE}/communication_spatial_heatmap_data_ep_phase_constrained_no_pp.csv",
        validation=f"{COLLECTIVE}/communication_spatial_heatmap_ep_phase_constrained_validation_no_pp.json",
        html=MAIN_HTML,
    params:
        python=PY,
    log:
        f"{LOGS}/build_main_heatmap.log",
    shell:
        """
        mkdir -p $(dirname {log})
        {params.python} {input.code} \
          --source-csv {input.source} \
          --rank-topology {input.topology} \
          --edp-nic-device-source-csv {input.edp} \
          --dp-active-source-csv {input.dp} \
          --cp-active-source-csv {input.cp} \
          --output-csv {output.cells} \
          --validation-output {output.validation} \
          --html-output {output.html} \
          --ep-mtlink-attribution strict-serial-phase \
          > {log} 2>&1
        """


