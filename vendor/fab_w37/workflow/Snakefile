        EP_ACTIVE_HTML,
        EP_ACTIVE_STAMP,


rule prepare_raw_view:
    input:
        code=f"{SCRIPTS}/prepare_raw_view.py",
        mtlink_root=RAW["mtlink_root"],
        nic_root=RAW["nic_root"],
    output:
        validation=f"{READINESS}/raw_view.json",
    params:
        python=PY,
        raw_view=RAW_VIEW,
    log:
        f"{LOGS}/prepare_raw_view.log",
    shell:
        """
        mkdir -p $(dirname {log})
        {params.python} {input.code} \
          --mtlink-root {input.mtlink_root} \
          --nic-root {input.nic_root} \
          --output-root {params.raw_view} \
          --validation-output {output.validation} \
          > {log} 2>&1
        """


