"""Default: frozen profiler-derived input validation, never a raw scan.

Optional named rules exist only when their explicit dataset is configured.
The archived workflow remains byte-preserved; never include its global `all`.
"""
from pathlib import Path
import sys
ROOT = Path(workflow.basedir).resolve().parents[1]
sys.path.insert(0, str(ROOT/'src'))
from x10000_analysis.v610 import mapped_spec, VENDOR
PYTHON = str(ROOT/'.venv/bin/python')
DRIVER = str(ROOT/'scripts/v610/profiler.py')
RUN = Path(config.get('run_root',ROOT/'results/v610/profiler-input-check')).resolve()
assert RUN.is_relative_to(ROOT/'results/v610')

rule all:
    input: str(RUN/'derived_inputs.json')

rule derived_inputs:
    input:
        observations=mapped_spec('binding')['inputs']['observations']['path'],
        driver=DRIVER,
        spec=str(VENDOR/'docs/w37/1f1b/binding/inputs.json'),
        adapter=str(ROOT/'src/x10000_analysis/v610.py')
    output: str(RUN/'derived_inputs.json')
    shell: "{PYTHON:q} -B {DRIVER:q} derived --output {output:q}"

if config.get('framework_root'):
    rule profiler_inventory:
        input:
            raw=config['framework_root'], driver=DRIVER,
            script=str(VENDOR/'case_256gpu_pp16_cp2_a2a/scripts/inventory_framework.py')
        output: str(RUN/'profiler/framework_readiness.json')
        params: output=str(RUN/'profiler')
        shell: "{PYTHON:q} -B {DRIVER:q} profiler --allow-raw-inventory --raw-root {input.raw:q} --output {params.output:q}"

if config.get('communication_root') and config.get('rank_host_map'):
    rule optional_communication_inventory:
        input:
            raw=config['communication_root'], ranks=config['rank_host_map'], driver=DRIVER,
            script=str(VENDOR/'case_256gpu_pp16_cp2_a2a/scripts/inventory_hardware.py')
        output: str(RUN/'communication/hardware_readiness.json')
        params: output=str(RUN/'communication')
        shell: "{PYTHON:q} -B {DRIVER:q} communication --allow-raw-inventory --raw-root {input.raw:q} --rank-host-map {input.ranks:q} --output {params.output:q}"
